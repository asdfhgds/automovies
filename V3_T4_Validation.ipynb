   "source": [
    "# Movie-Grounded Creative Director V3 — T4 Validation Notebook\n",
    "\n",
    "Run all cells sequentially. The movie data will be uploaded manually in Cell 2."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# CELL 1: Environment setup & package install\n",
    "# ============================================================\n",
    "import sys, os, json, shutil, torch\n",
    "from pathlib import Path\n",
    "\n",
    "# Install package in development mode\n",
    "!pip install -e /content/automovies -q\n",
    "\n",
    "# Add src to path\n",
    "sys.path.insert(0, '/content/automovies/src')\n",
    "\n",
    "# GPU check\n",
    "print(f\"CUDA available: {torch.cuda.is_available()}\")\n",
    "if torch.cuda.is_available():\n",
    "    print(f\"GPU: {torch.cuda.get_device_name(0)}\")\n",
    "    print(f\"VRAM: {torch.cuda.get_device_properties(0).total_memory / 1e9:.1f} GB\")\n",
    "else:\n",
    "    print(\"⚠️ Running on CPU — will be slow\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# CELL 2: Upload movie_index.json manually\n",
    "# ============================================================\n",
    "from google.colab import files\n",
    "import io\n",
    "\n",
    print(\"Please select your movie_index.json file...\")\n",
    uploaded = files.upload()\n",
    "\n",
    if uploaded:\n",
    "    # Save to the expected location\n",
    "    PROJECT_DIR = Path('/content/automovies/data/bc6384be-47a5-4ee8-8674-7ff861472026')\n",
    "    PROJECT_DIR.mkdir(parents=True, exist_ok=True)\n",
    "    MOVIE_INDEX = PROJECT_DIR / 'movie_index.json'\n",
    "    \n",
    "    # uploaded is a dict {filename: bytes}\n",
    "    for filename, content in uploaded.items():\n",
    "        with open(MOVIE_INDEX, 'wb') as f:\n",
    "            f.write(content)\n",
    "        print(f\"✓ Saved {filename} → {MOVIE_INDEX}\")\n",
    "else:\n",
    "    print(\"No file uploaded\")\n",
    "\n",
    "# Verify\n",
    "if MOVIE_INDEX.exists():\n",
    "    with open(MOVIE_INDEX, 'r', encoding='utf-8') as f:\n",
    "        movie_index = json.load(f)\n",
    "    print(f\"\\nMovie: {movie_index['movie']['title']}\")\n",
    "    print(f\"Duration: {movie_index['movie']['duration_sec']}s\")\n",
    "    print(f\"Scenes: {len(movie_index['scenes'])}\")\n",
    "else:\n",
    "    print(\"❌ Movie index not found\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# CELL 3: Build SceneFacts & verify vocabulary\n",
    "# ============================================================\n",
    "from director.scene_facts import SceneFacts\n",
    "\n",
    "facts = SceneFacts.from_movie_intelligence(movie_index=movie_index)\n",
    "print(f\"Known characters: {facts.known_characters()}\")\n",
    "print(f\"Known locations: {facts.known_locations()}\")\n",
    "print(f\"Known objects (first 15): {facts.known_objects()[:15]}\")\n",
    "print(f\"Known actions: {facts.known_actions()}\")\n",
    "print(f\"Known themes: {facts.known_themes()}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# CELL 4: Test two-level context builder\n",
    "# ============================================================\n",
    "from director.context_builder import DirectorContextBuilder\n",
    "\n",
    "cb = DirectorContextBuilder(max_tokens=4096, reserve_for_output=2048)\n",
    "ctx, meta = cb.build_concept_generation_context(\n",
    "    movie_index['movie'], facts\n",
    ")\n",
    "\n",
    "print(\"=== CONTEXT METADATA ===\")\n",
    "for k, v in meta.items():\n",
    "    print(f\"  {k}: {v}\")\n",
    "\n",
    "# Verify inventory has all scenes\n",
    "inventory_section = ctx.split('## FULL MOVIE INVENTORY')[1].split('## WHAT ACTUALLY EXISTS')[0]\n",
    "inventory_lines = [l for l in inventory_section.strip().split('\\n') if l.strip()]\n",
    "print(f\"\\nInventory scenes: {len(inventory_lines)} (expected {len(movie_index['scenes'])})\")\n",
    "print(f\"First: {inventory_lines[0]}\")\n",
    "print(f\"Last:  {inventory_lines[-1]}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# CELL 5: Initialize Qwen provider (4-bit)\n",
    "# ============================================================\n",
    "from director.providers.qwen import QwenProvider\n",
    "\n",
    "provider = QwenProvider(\n",
    "    model_id=\"Qwen/Qwen3-4B-Instruct-2507\",\n",
    "    dtype=torch.bfloat16,\n",
    "    device_map=\"auto\",\n",
    "    load_in_4bit=True,\n",
    "    max_new_tokens=2048,\n",
    "    temperature=0.7,\n",
    "    top_p=0.9,\n",
    ")\n",
    "\n",
    "print(\"Loading model (this takes 30-60s on first run)...\")\n",
    "_ = provider.generate_text(\"Say hello in one word.\")\n",
    "print(\"✓ Model loaded and warmed up\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# CELL 6: Run full director pipeline\n",
    "# ============================================================\n",
    "from director.grounded import MovieGroundedDirector\n",
    "from director.memory import CreativeMemory\n",
    "\n",
    "memory_dir = PROJECT_DIR / 'memory'\n",
    "memory_dir.mkdir(exist_ok=True)\n",
    "\n",
    "director = MovieGroundedDirector(\n",
    "    llm=provider.generate_text,\n",
    "    memory_dir=memory_dir,\n",
    "    context_tokens=4096,\n",
    "    reserve_for_output=2048,\n",
    ")\n",
    "\n",
    "print(\"Running director pipeline (6 concepts)...\")\n",
    "result = director.develop(\n",
    "    movie_metadata=movie_index['movie'],\n",
    "    scale_facts=facts,\n",
    "    num_concepts=6,\n",
    "    min_coverage=0.4,\n",
    "    duration_sec=90,\n",
    ")\n",
    "\n",
    "print(f\"\\n=== RESULT ===\")\n",
    "print(f\"Verdict: {result.get('verdict', 'UNKNOWN')}\")\n",
    "print(f\"Selected concept: {result.get('selected_concept', {}).get('title', 'NONE')}\")\n",
    "print(f\"Plan generated: {'YES' if result.get('plan') else 'NO'}\")\n",
    "print(f\"LLM calls: {result.get('llm_stats', {}).get('llm_calls')}\")\n",
    "print(f\"Regeneration rounds: {result.get('llm_stats', {}).get('regeneration_rounds')}\")\n",
    "\n",
    "sel = result.get('selected_concept')\n",
    "if sel:\n",
    "    print(f\"\\nSelected thesis: {sel.get('thesis')}\")\n",
    "    ev = sel.get('_evidence')\n",
    "    if ev:\n",
    "        print(f\"Reference coverage: {ev.get('reference_coverage')}\")\n",
    "        print(f\"Claim coverage (detail): {ev.get('claim_coverage_detail')}\")\n",
    "        print(f\"Claim coverage (label): {ev.get('claim_coverage')}\")\n",
    "        print(f\"Claims decomposed: {len(ev.get('claims', []))}\")\n",
    "        for c in ev.get('claims', []):\n",
    "            print(f\"  [{c['claim_id']}] {c['type']} → {c['status']} (conf={c['confidence']}, scenes={len(c['support'])})\")\n",
    "            print(f\"    text: {c['text'][:80]}...\")\n",
    "        print(f\"Supporting scenes: {ev.get('supporting_scene_ids')}\")\n",
    "\n",
    "plan = result.get('plan')\n",
    "if plan:\n",
    "    audit = plan.get('grounding_audit', {})\n",
    "    print(f\"\\n=== PLAN AUDIT ===\")\n",
    "    print(f\"Coverage: {audit.get('coverage')}\")\n",
    "    print(f\"Sufficient: {audit.get('sufficient')}\")\n",
    "    print(f\"Invented terms: {audit.get('invented_terms')}\")\n",
    "    print(f\"Grounded terms: {audit.get('grounded_terms')[:10]}...\")\n",
    "else:\n",
    "    print(f\"\\n=== PLAN REJECTED ===\")\n",
    "    rej = result.get('plan_rejection', {})\n",
    "    print(f\"Reason: {rej.get('reason')}\")\n",
    "    if rej.get('audit'):\n",
    "        print(f\"Invented: {rej['audit'].get('invented_terms')}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# CELL 7: Save validation report\n",
    "# ============================================================\n",
    "from director.report import write_report\n",
    "from director.evidence import EvidenceAnalyzer\n",
    "\n",
    "analyzer = EvidenceAnalyzer(facts)\n",
    "report_path = write_report(\n",
    "    project_dir=PROJECT_DIR,\n",
    "    result=result,\n",
    "    analyzer=analyzer,\n",
    ")\n",
    "print(f\"✓ Report written to: {report_path}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# CELL 8: Display reasoning report\n",
    "# ============================================================\n",
    "md_path = PROJECT_DIR / 'reports' / 'director_reasoning.md'\n",
    "if md_path.exists():\n",
    "    with open(md_path, 'r', encoding='utf-8') as f:\n",
    "        content = f.read()\n",
    "    print(content[:6000])\n",
    "    print(\"\\n... [truncated] ...\")\n",
    "else:\n",
    "    print(\"Reasoning report not found\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# CELL 9: Validation summary (for milestone tracking)\n",
    "# ============================================================\n",
    "print(\"=== V3 VALIDATION SUMMARY ===\")\n",
    "print(f\"Movie: {movie_index['movie']['title']}\")\n",
    "print(f\"Total scenes: {len(movie_index['scenes'])}\")\n",
    "print(f\"Verdict: {result.get('verdict')}\")\n",
    "print(f\"Concepts generated: {len(result.get('generated_concepts', []))}\")\n",
    "print(f\"Rejected: {len(result.get('rejected_concepts', []))}\")\n",
    "sel = result.get('selected_concept')\n",
    "if sel:\n",
    "    print(f\"Selected: {sel.get('title')}\")\n",
    "    ev = sel.get('_evidence')\n",
    "    if ev:\n",
    "        print(f\"  Reference coverage: {ev.get('reference_coverage')}\")\n",
    "        print(f\"  Claim coverage: {ev.get('claim_coverage_detail')}\")\n",
    "        print(f\"  Claims: {len(ev.get('claims', []))}\")\n",
    "print(f\"Plan status: {'PASS' if result.get('plan') else 'REJECTED/FAIL'}\")\n",
    "if result.get('plan_rejection'):\n",
    "    print(f\"Plan rejection: {result['plan_rejection'].get('reason')}\")\n",
    "print(f\"LLM calls: {result.get('llm_stats', {}).get('llm_calls')}\")\n",
    "print(f\"Regeneration rounds: {result.get('llm_stats', {}).get('regeneration_rounds')}\")\n",
    "print(f\"GPU: {torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'CPU'}\")\n",
    "print(f\"Model: Qwen/Qwen3-4B-Instruct-2507 (4-bit)\")\n",
    "\n",
    "# Save summary JSON for CI/CD\n",
    "summary = {\n",
    "    \"movie\": movie_index['movie']['title'],\n",
    "    \"total_scenes\": len(movie_index['scenes']),\n",
    "    \"verdict\": result.get('verdict'),\n",
    "    \"concepts_generated\": len(result.get('generated_concepts', [])),\n",
    "    \"rejected_concepts\": len(result.get('rejected_concepts', [])),\n",
    "    \"selected_concept\": sel.get('title') if sel else None,\n",
    "    \"reference_coverage\": ev.get('reference_coverage') if (sel and ev) else None,\n",
    "    \"claim_coverage\": ev.get('claim_coverage_detail') if (sel and ev) else None,\n",
    "    \"plan_passed\": result.get('plan') is not None,\n",
    "    \"llm_calls\": result.get('llm_stats', {}).get('llm_calls'),\n",
    "    \"regeneration_rounds\": result.get('llm_stats', {}).get('regeneration_rounds'),\n",
    "    \"gpu\": torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'CPU',\n",
    "    \"model\": \"Qwen/Qwen3-4B-Instruct-2507 (4-bit)\",\n",
    "    \"full_movie_inventory\": True,\n",
    "    \"context_truncated\": meta.get('truncated', False),\n",
    "}\n",
    "summary_path = PROJECT_DIR / 'reports' / 'validation_summary.json'\n",
    "with open(summary_path, 'w', encoding='utf-8') as f:\n",
    "    json.dump(summary, f, indent=2, ensure_ascii=False)\n",
    "print(f\"\\nSummary saved to: {summary_path}\")"
   ]
  }
