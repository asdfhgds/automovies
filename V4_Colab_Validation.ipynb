        "        print(f'\\n=== {fname} ===')\n",
        "        content = fpath.read_text(encoding='utf-8')\n",
        "        if fname.endswith('.json'):\n",
        "            data = json.loads(content)\n",
        "            print(json.dumps(data, indent=2)[:5000])\n",
        "            if len(content) > 5000:\n",
        "                print('... [truncated]')\n",
        "        else:\n",
        "            print(content[:5000])\n",
        "            if len(content) > 5000:\n",
        "                print('... [truncated]')\n",
        "    else:\n",
        "        print(f'\\n=== {fname} === NOT FOUND')"
      ]
