        "# @title Run V5 Validation (Real Qwen on T4)\n",
        "import time\n",
        "import json\n",
        "from pathlib import Path\n",
        "\n",
        "print('=' * 60)\n",
        "print('STARTING V5 REAL-QWEN VALIDATION')\n",
        "print('=' * 60)\n",
        "\n",
        "start_time = time.time()\n",
        "\n",
        "# Run the V5 validation script (includes V4 director + V5 grounded script + editorial director)\n",
        "cmd = [\n",
        "    sys.executable,\n",
        "    'scripts/run_director_validation.py',\n",
        "    '--project', 'data/bc6384be-47a5-4ee8-8674-7ff861472026',\n",
        "    '--num-concepts', '6',\n",
        "    '--min-coverage', '0.4',\n        \"--v5\",  # Enable V5 pipeline\n",
        "]\n",
        "\n",
        "print(f'Command: {\" \".join(cmd)}')\n",
        "print('-' * 40)\n",
        "\n",
        "result = subprocess.run(cmd, cwd='/content/automovies', capture_output=True, text=True, timeout=3600)\n",
        "\n",
        "elapsed = time.time() - start_time\n",
        "\n",
        "print(f'Exit code: {result.returncode}')\n",
        "print(f'Runtime: {elapsed:.1f}s ({elapsed/60:.1f} min)')\n",
        "print('-' * 40)\n",
        "print('STDOUT:')\n",
        "print(result.stdout[-3000:] if len(result.stdout) > 3000 else result.stdout)\n",
        "if result.stderr:\n",
        "    print('-' * 40)\n",
        "    print('STDERR:')\n",
        "    print(result.stderr[-2000:] if len(result.stderr) > 2000 else result.stderr)"
      ]
    },
