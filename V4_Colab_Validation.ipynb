        "reports_dir = Path('/content/automovies/data/bc6384be-47a5-4ee8-8674-7ff861472026/reports')\n",
        "\n",
        "for fname in ['director_validation.json', 'director_reasoning.md', 'validation_summary.json']:\n",
        "    fpath = reports_dir / fname\n",
