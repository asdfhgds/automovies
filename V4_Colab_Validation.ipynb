        "# @title Validate Plan Output (if exists)\n",
        "import json\n",
        "from pathlib import Path\n",
        "\n",
        "plan_path = Path('/content/automovies/data/bc6384be-47a5-4ee8-8674-7ff861472026/director_plan.json')\n",
        "if plan_path.exists():\n",
        "    with open(plan_path) as f:\n",
        "        plan = json.load(f)\n",
        "    \n",
        "    print('=== director_plan.json ===')\n",
        "    print(json.dumps(plan, indent=2)[:4000])\n",
        "    \n",
        "    # Validate plan structure\n",
        "    print('\\n=== PLAN VALIDATION ===')\n",
        "    if 'editorial_plan' in plan:\n",
        "    print('editorial_plan present')\n",
        "    ep = plan['editorial_plan']\n",
        "    if 'visual' in ep:\n",
        "        v = ep['visual']\n",
        "        print(\"  visual.scene_id: {}\".format(v.get('scene_id')))\n",
        "        print(\"  visual.start_sec: {}\".format(v.get('start_sec')))\n",
        "        print(\"  visual.end_sec: {}\".format(v.get('end_sec')))\n",
        "        print(\"  visual.source_fact_refs: {}\".format(v.get('source_fact_refs')))\n",
        "        if 'editing' in ep:\n",
        "            e = ep['editing']\n",
        "            for k in ['transition', 'pacing', 'rhythm', 'emphasis', 'repetition', 'purpose']:\n",
        "                print(\"  editing.{}: {}\".format(k, e.get(k)))\n",
        "        if 'audio' in ep:\n",
        "            a = ep['audio']\n",
        "            for k in ['movie_audio', 'narration', 'music']:\n",
        "                print(\"  audio.{}: {}\".format(k, a.get(k)))\n",
        "    else:\n",
        "        print('editorial_plan MISSING')\n",
        "    \n",
        "    if 'grounding_audit' in plan:\n",
        "        audit = plan['grounding_audit']\n",
        "        print(\"\\n  overall_valid: {}\".format(audit.get('overall_valid')))\n",
        "        print(\"  fact_validation.valid: {}\".format(audit.get('fact_validation', {}).get('valid')))\n",
        "        print(\"  editorial_validation.valid: {}\".format(audit.get('editorial_validation', {}).get('valid')))\n",
        "        if 'legacy_prose_audit' in audit and audit['legacy_prose_audit']:\n",
        "            lpa = audit['legacy_prose_audit']\n",
        "            print(\"  legacy.sufficient: {}\".format(lpa.get('sufficient')))\n",
        "            print(\"  legacy.coverage: {}\".format(lpa.get('coverage')))\n",
        "            print(\"  legacy.invented_terms: {}\".format(lpa.get('invented_terms')[:10]))\n",
        "else:\n",
        "    print('grounding_audit MISSING')"
      ]
    },
